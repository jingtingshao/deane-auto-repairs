# Copy this file to .env and fill in your Gmail App Password:
#   copy .env.example .env

ADMIN_PIN=deane123

# Gmail SMTP (use an App Password, not your normal Gmail password)
# Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=deaneautonz@gmail.com
SMTP_PASS=your-16-char-app-password

MAIL_FROM=Deane Auto Repairs <deaneautonz@gmail.com>

# Live website URL for links inside customer emails
PUBLIC_BASE_URL=https://www.deaneauto.co.nz

# Optional on Render: persist quotes/reports/photos on a disk
# DATA_DIR=/data
# UPLOADS_DIR=/data/uploads

# Google Drive backup (personal Gmail OAuth — never commit secrets)
GOOGLE_DRIVE_FOLDER_ID=1WPsTY1EGx5HadxUmY3V4Om60yZ4HpeL1
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# One-time on this PC: npm run backup:auth
BACKUP_HOUR_NZ=2
BACKUP_KEEP_COUNT=14
# BACKUP_INCLUDE_PHOTOS=true
# Old service-account keys are not used for Drive (personal Gmail has no SA quota).
