# Copy this file to .env and fill in your Gmail App Password:
#   copy .env.example .env

# Required. Use a strong PIN (8+ characters). Never use a published default.
ADMIN_PIN=

# Temporary public-site lock while the website is unfinished.
# Set this on Render to force a preview PIN on the customer website.
# Leave empty when the site is ready for public go-live.
# SITE_PIN=your-preview-pin-here

# Gmail SMTP (use an App Password, not your normal Gmail password)
# Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=deaneautonz@gmail.com
SMTP_PASS=your-16-char-app-password

MAIL_FROM=Deane Auto Repairs <deaneautonz@gmail.com>

# WebSMS Connexus (NZ) — Members Area → API Keys → client_id + client_secret
# https://websms.co.nz/api/connexus/
WEBSMS_CLIENT_ID=
WEBSMS_CLIENT_SECRET=
# Optional sender / shortcode from WebSMS portal
# WEBSMS_FROM=
# Set true to test without sending or billing
# WEBSMS_SANDBOX=true
# Optional webhook shared secret (also append ?secret=... to the WebSMS webhook URL)
# WEBSMS_WEBHOOK_SECRET=

# Live website URL for links inside customer emails
PUBLIC_BASE_URL=https://www.deaneauto.co.nz

# Google review CTA on invoices / invoice emails (optional overrides)
# Prefer the “Get more reviews” link from Google Business Profile.
# GOOGLE_REVIEW_URL=https://g.page/r/XXXX/review
# Or Place ID → builds https://search.google.com/local/writereview?placeid=...
# GOOGLE_PLACE_ID=

# Optional on Render: persist quotes/reports/photos on a disk
# DATA_DIR=/data
# UPLOADS_DIR=/data/uploads

# Google Drive backup (personal Gmail OAuth — never commit secrets)
GOOGLE_DRIVE_FOLDER_ID=1WPsTY1EGx5HadxUmY3V4Om60yZ4HpeL1
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# One-time on this PC: npm run backup:auth
# USB copy: Admin dashboard → Download zip (works without Drive)
BACKUP_HOUR_NZ=2
BACKUP_KEEP_COUNT=14
# BACKUP_INCLUDE_PHOTOS=true
# Old service-account keys are not used for Drive (personal Gmail has no SA quota).
